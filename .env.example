# Única URL do projeto. O Supavisor em TRANSACTION MODE (porta 6543) serve tanto a
# aplicação em execução quanto as migrations e scripts administrativos.
#
# Transaction mode (e não session mode, 5432) porque o SGA roda em Cloudflare Workers:
# a session mode seguraria uma sessão dedicada do Postgres por isolate, e o pool padrão
# do Supabase (20) seria esgotado, enfileirando requests por até um minuto.
#
# Em Connect > Connection string > URI, copie a transação. Codifique percentualmente a
# senha (caracteres como & # ? e espaço quebram a URL). Nunca use NEXT_PUBLIC_.
#
# A CA raiz do Supabase é pública e versionada em `supabase-ca.pem`: não há variável de
# certificado porque o Workers não tem sistema de arquivos. Rode `npm run ca:sync` se ela
# mudar. A validação do certificado nunca é desligada.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_PERCENT_ENCODED@aws-REGIAO.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Auth: URL e publishable key são seguros para uso no navegador.
# Copie ambos no painel Supabase em Connect. Nunca use SUPABASE_SECRET_KEY no cliente.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_PELA_CHAVE
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Domínio e rota do Worker já publicado na Cloudflare.
# APP_DOMAIN alimenta links absolutos em e-mails e no reset de senha.
APP_DOMAIN=localhost

# Gere com: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Chave mestra de criptografia das credenciais por organizacao (Zernio).
# Trocar esta valor invalida todas as credenciais ja gravadas.
INTEGRATION_ENCRYPTION_KEY=troque-por-uma-chave-secreta-de-no-minimo-32-caracteres

# Zernio substitui a integracao direta com a Meta Cloud API. Cada organizacao informa
# a propria API key e o accountId do WhatsApp; nada aqui e global por organizacao.
# O segredo do webhook tambem e por organizacao e fica cifrado no banco, nao no ambiente.
ZERNIO_API_BASE_URL=https://zernio.com/api/v1

# Comunicação do SGA (e-mail transacional e disparo da fila). Segredos de servidor.
RESEND_API_KEY=
SGA_EMAIL_FROM=SGA <no-reply@seu-dominio.com>
SGA_EMAIL_REPLY_TO=
# Gere com: openssl rand -base64 32. Protege POST /api/messaging/dispatch,
# invocado pelo Cron Trigger da Cloudflare.
MESSAGING_DISPATCH_TOKEN=replace-with-a-long-random-secret
