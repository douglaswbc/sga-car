# Desenvolvimento sem Docker: no painel Supabase, abra Connect e copie a URL do
# Session Pooler (porta 5432). Preserve `sslmode=verify-full` e nunca use NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-REGIAO.pooler.supabase.com:5432/postgres?sslmode=verify-full
# Baixe o certificado raiz no painel Supabase (Connect) e mantenha-o fora do Git.
DATABASE_CA_CERT_PATH=./supabase-ca.crt

# Supabase Auth: URL e publishable key são seguros para uso no navegador.
# Copie ambos no painel Supabase em Connect. Nunca use SUPABASE_SECRET_KEY no cliente.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_PELA_CHAVE
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Usado apenas na implantação da VPS com `docker compose`.
APP_DOMAIN=localhost
POSTGRES_DB=sga
POSTGRES_USER=sga
POSTGRES_PASSWORD=change-this-to-a-long-unique-password

# Gere com: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Credenciais da Meta WhatsApp Cloud API. Preencha somente ao implementar a integração.
# As credenciais usadas nos envios de cada organização são configuradas no SGA e cifradas no banco.
# As variáveis abaixo servem somente aos diagnósticos globais da plataforma.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=
# Segredo do app Meta, usado para validar a assinatura X-Hub-Signature-256 do webhook.
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_GRAPH_VERSION=v26.0
INTEGRATION_ENCRYPTION_KEY=troque-por-uma-chave-secreta-de-no-minimo-32-caracteres

# Comunicação do SGA (e-mail transacional e disparo da fila). Segredos de servidor.
RESEND_API_KEY=
SGA_EMAIL_FROM=SGA <no-reply@seu-dominio.com>
SGA_EMAIL_REPLY_TO=
# Gere com: openssl rand -base64 32. Protege POST /api/messaging/dispatch.
MESSAGING_DISPATCH_TOKEN=replace-with-a-long-random-secret

# Agendador interno de mensagens (opcional). Quando habilitado, o próprio SGA
# processa a fila periodicamente, sem depender de cron/n8n externos.
# Alternativas: cron da VPS ou n8n chamando POST /api/messaging/dispatch.
MESSAGING_SCHEDULER_ENABLED=false
MESSAGING_SCHEDULER_INTERVAL_MS=900000
